  "name": "Workflow 3 - Cleanup",
  "nodes": [
    {
      "parameters": {
        "content": "## Daily cleanup\nRuns once a day. Deletes processed job_postings older than 30 days, then reclaims space.",
        "height": 256,
        "width": 608,
        "color": 4
      },
      "type": "n8n-nodes-base.stickyNote",
      "typeVersion": 1,
      "position": [
        -320,
        -160
      ],
      "id": "b1e2c3d4-1111-4a11-9111-000000000001",
      "name": "Sticky Note"
    },
    {
      "parameters": {
        "rule": {
          "interval": [
            {
              "field": "days",
              "triggerAtHour": 3
            }
          ]
        }
      },
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.3,
      "position": [
        -272,
        0
      ],
      "id": "b1e2c3d4-1111-4a11-9111-000000000002",
      "name": "Schedule Trigger"
    },
    {
      "parameters": {
        "operation": "executeQuery",
        "query": "DELETE FROM job_postings\nWHERE is_processed = TRUE\n  AND created_at < NOW() - INTERVAL '30 days';",
        "options": {}
      },
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 2.6,
      "position": [
        0,
        0
      ],
