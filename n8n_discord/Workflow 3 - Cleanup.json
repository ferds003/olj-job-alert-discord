      "name": "Delete old processed jobs",
      "credentials": {
        "postgres": {
          "id": "ZzBIvq2za0U7odoL",
          "name": "job_alert_client"
        }
      }
    },
    {
      "parameters": {
        "content": "## Note\nVACUUM cannot run inside a transaction block. If this node errors with\n\"VACUUM cannot run inside a transaction block\", run\n`VACUUM ANALYZE job_postings;` manually via psql/pgAdmin instead\n(or on a separate schedule outside n8n), and disable this node.",
        "height": 224,
        "width": 384,
        "color": 3
      },
      "type": "n8n-nodes-base.stickyNote",
      "typeVersion": 1,
      "position": [
        288,
        -240
      ],
      "id": "b1e2c3d4-1111-4a11-9111-000000000004",
      "name": "Sticky Note1"
    },
    {
      "parameters": {
        "operation": "executeQuery",
        "query": "VACUUM ANALYZE job_postings;",
